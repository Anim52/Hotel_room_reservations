<UserControl x:Class="AplicationApp.Views.Pages.AdminServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicationApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             
             >
    <Grid Background="#f0f0f3" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Grid.Column="0"
            Background="White"
            CornerRadius="12"
            Padding="20"
            Margin="0,0,20,0"
            >
            <Border.Effect>
                <DropShadowEffect Color="#888" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Margin="0,10" 
                    Content="Выполнить" 
                    Command="{Binding CompleteRequestCommand}" 
                    Width="180" Height="50"
                    FontSize="14"
                    />

                <Button Margin="0,10" 
                    Content="Удалить" 
                    Command="{Binding DeleteRequestCommand}" 
                    Width="180" Height="50"
                    FontSize="14"
                    />
            </StackPanel>
        </Border>

        <!-- Правая панель — список заявок -->
        <Border Grid.Column="1"
            Background="White"
            CornerRadius="12"
            Padding="10"
            >
            <Border.Effect>
                <DropShadowEffect Color="#888" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <ListView ItemsSource="{Binding ServiceRequests}" 
      SelectedItem="{Binding SelectedService}"
      Background="Transparent"
      BorderThickness="0"
      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#fafafa"
                CornerRadius="10"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1"
                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="{Binding Fullname}" 
                           FontWeight="Bold" 
                           FontSize="18" 
                           Foreground="#333"/>
                                <TextBlock Text="{Binding Description}" 
                           FontSize="15" 
                           Foreground="#555" 
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Status}" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="DarkGreen"
                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Border>
    </Grid>
</UserControl>
