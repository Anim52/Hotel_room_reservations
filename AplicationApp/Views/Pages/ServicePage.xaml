<UserControl x:Class="AplicationApp.Views.Pages.ServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicationApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#E0E0E0">
    <Grid>
        <Border CornerRadius="20" Background="White" Padding="40" Margin="60">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                <TextBlock Text="Хотите заказать услугу?" FontSize="28" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,30" TextAlignment="Center"/>

                <TextBlock Text="Опишите свою услугу:" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBox Width="400" Height="100" TextWrapping="Wrap" AcceptsReturn="True" FontSize="16"
                      Text="{Binding NewRequestDescription, UpdateSourceTrigger=PropertyChanged}" 
                      Padding="10" BorderBrush="#94A3B8" BorderThickness="1" Background="#F0F0F0"/>

                <Button Content="🛎 Заказать услугу" Margin="0,30,0,0" Width="220" Height="55" 
                     FontSize="16" FontWeight="Bold" Foreground="White"
                     Background="#3B82F6" BorderBrush="#2563EB" BorderThickness="1"
                     Command="{Binding CreateRequestCommand}">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
