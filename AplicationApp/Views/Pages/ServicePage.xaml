<UserControl x:Class="AplicationApp.Views.Pages.ServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicationApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <StackPanel>
                <Label Content="Хотите заказать услугу?" FontSize="26" HorizontalAlignment="Center" Margin="0,70,0,0"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <TextBlock Text="Описание" FontSize="18" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                    <TextBox  Width="300" Text="{Binding NewRequestDescription, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button  Content="Заказать!"  Margin="0,30,0,0" Command="{Binding CreateRequestCommand}" Background="#1E293B" Width="180" Height="50"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
