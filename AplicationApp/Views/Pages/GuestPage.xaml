<UserControl x:Class="AplicationApp.Views.Pages.GuestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicationApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FAFAFA" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Список пользователей"
                FontSize="26"
                FontWeight="Bold"
                Foreground="#37474F"
                Margin="0,0,0,20"/>

        <!-- Список пользователей -->
        <ListView Grid.Row="1"
       ItemsSource="{Binding UsersList}"
       SelectedItem="{Binding SelectedUser}"
       Background="Transparent"
       BorderThickness="0"
       ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="5"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White"
                 CornerRadius="12"
                 Padding="12"
                 BorderBrush="#DDD"
                 BorderThickness="1"
                 HorizontalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="50" Height="50"
                          Fill="#E0E0E0"
                          Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding FirstName}" 
                                FontSize="18" 
                                FontWeight="SemiBold" 
                                Foreground="#263238"/>
                                <TextBlock Text="{Binding LastName}" 
                                FontSize="16" 
                                Foreground="#455A64"/>
                                <TextBlock Text="{Binding ContactDetails}" 
                                FontSize="14" 
                                Foreground="#78909C"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        <!-- Кнопка удаления -->
        <Button Grid.Row="2"
             Content="Удалить пользователя"
             Command="{Binding DeleteUserCommand}"
             HorizontalAlignment="Right"
             Margin="0,20,0,0"
             Width="200" Height="50"
             Background="#D32F2F"
             Foreground="White"
             FontWeight="SemiBold"
             BorderThickness="0"
             Cursor="Hand"/>
    </Grid>
</UserControl>
