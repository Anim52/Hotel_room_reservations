<UserControl x:Class="AplicationApp.Views.Pages.UserViewReservation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicationApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="800" Background="#E0E0E0">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: форма и бронирования -->
        <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="📅 Создать бронирование" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#1E293B"/>

                <TextBlock Text="Выбранный номер" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding NomerList}" DisplayMemberPath="Number"
                   SelectedItem="{Binding SelectedNomer}" Width="250" Margin="0,5,0,10"/>

                <TextBlock Text="Дата заезда" FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding ArrivalDate}" Width="250" Margin="0,5,0,10"/>

                <TextBlock Text="Дата выезда" FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding DepartureDate}" Width="250" Margin="0,5,0,10"/>

                <TextBlock Text="Количество человек" FontWeight="SemiBold"/>
                <TextBox Text="{Binding NumberOfPersons}" Width="250" Margin="0,5,0,20"/>

                <Button Content="✅ Забронировать" Command="{Binding AddReservationCommand}"
                 Width="200" Height="50" FontSize="16" FontWeight="Bold"
                 Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,0,20">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.4"/>
                    </Button.Effect>
                </Button>

                <TextBlock Text="{Binding CalculatedPrice, StringFormat='💰 Цена: {0} ₽'}"
                    FontSize="18" FontWeight="Bold" Foreground="DarkGreen" Margin="0,0,0,30"/>

                <TextBlock Text="🧾 Мои бронирования" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding UserReservationList}" SelectedItem="{Binding SelectedReservation}" Margin="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,0,0,10" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Background="#FAFAFA">
                                <StackPanel>
                                    <TextBlock Text="Номер:" FontWeight="Bold" Foreground="#334155"/>
                                    <TextBlock Text="{Binding Nomer.Number}"/>

                                    <TextBlock Text="Даты:" FontWeight="Bold" Foreground="#334155" Margin="0,10,0,0"/>
                                    <TextBlock>
                                 <Run Text="С "/>
                                 <Run Text="{Binding ArrivalDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                 <Run Text=" по "/>
                                 <Run Text="{Binding DepartureDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                    </TextBlock>

                                    <TextBlock Text="Статус:" FontWeight="Bold" Foreground="#334155" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding Status}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Правая часть: список номеров -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="🏨 Доступные номера" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

                <ListBox ItemsSource="{Binding NomerList}" SelectedItem="{Binding SelectedNomer}" Margin="0" 
              BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,20"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#D0E8FF"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E6F0FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" CornerRadius="10" Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
                                <DockPanel>
                                    <Image Source="{Binding ImagePath}" Width="120" Height="100" Stretch="UniformToFill" Margin="10"/>
                                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Номер:" FontWeight="Bold" Foreground="#A98743"/>
                                        <TextBlock Text="{Binding Number}" FontSize="16"/>

                                        <TextBlock Text="Этаж:" FontWeight="Bold" Foreground="#A98743" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Floor}" FontSize="14"/>

                                        <TextBlock Text="Тип номера:" FontWeight="Bold" Foreground="#A98743" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding TypeNumder}" FontSize="14"/>

                                        <TextBlock Text="Стоимость:" FontWeight="Bold" Foreground="#A98743" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Cost}" FontSize="14"/>

                                        <TextBlock Text="Описание:" FontWeight="Bold" Foreground="#A98743" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Description}" FontSize="14" TextWrapping="Wrap" Width="200"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
