<UserControl x:Class="AplicationApp.Views.Pages.UserViewReservation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicationApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <StackPanel Margin="20">
                <TextBlock Text="Создать бронирование" FontSize="24" Margin="0,0,0,20" />
                <TextBlock Text="Выбранный номер" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding NomerList}" 
                  DisplayMemberPath="Number" 
                  SelectedItem="{Binding SelectedNomer}" 
                  Width="200" 
                  Margin="0,0,0,10"/>
                <TextBlock Text="Дата заезда" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding ArrivalDate}" Width="200" Margin="0,0,0,10"/>
                <TextBlock Text="Дата выезда" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding DepartureDate}" Width="200" Margin="0,0,0,10"/>
                <TextBlock Text="Количество человек" HorizontalAlignment="Center"/>
                <TextBox Text="{Binding NumberOfPersons}" Width="200" Margin="0,0,0,10"/>
                <Button Content="Забронировать" 
                Command="{Binding AddReservationCommand}" 
                Width="150" 
                Margin="0,10,0,10"/>

                <TextBlock Text="{Binding CalculatedPrice, StringFormat='Цена: {0} ₽'}"
                            FontSize="16"
                            Foreground="DarkGreen"
                            FontWeight="Bold"
                            Margin="10"/>


                <TextBlock Text="Мои бронирования" FontSize="24" Margin="0,0,0,10" />



                <ListBox ItemsSource="{Binding UserReservationList}" 
         SelectedItem="{Binding SelectedReservation}" 
         Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,0,0,10" BorderBrush="Gray" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="Номер:" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Nomer.Number}" />

                                    <TextBlock Text="Даты:" FontWeight="Bold"/>
                                    <TextBlock Text="C"/>
                                    <TextBlock Text="{Binding ArrivalDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                    <TextBlock Text="По"/>
                                    <TextBlock Text="{Binding DepartureDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>

                                    <TextBlock Text="Статус:" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Status}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">

       
                
                <ListBox ItemsSource="{Binding NomerList, UpdateSourceTrigger=PropertyChanged}" 
                    SelectedItem="{Binding SelectedNomer, Mode=TwoWay}"
                    Background="Transparent"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10" Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Background="White">
                                <DockPanel>
                                    <Image Source="{Binding ImagePath}"
                  Width="120" Height="100" 
                  Stretch="UniformToFill" 
                  Margin="10" 
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"/>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Номер:" FontWeight="Bold" Foreground="#A98743"/>
                                        <TextBlock Text="{Binding Number}" FontSize="18"/>

                                        <TextBlock Text="Этаж:" FontWeight="Bold" Foreground="#A98743" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding Floor}" FontSize="16"/>

                                        <TextBlock Text="Тип номера:" FontWeight="Bold" Foreground="#A98743" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding TypeNumder}" FontSize="16"/>

                                        <TextBlock Text="Стоимость:" FontWeight="Bold" Foreground="#A98743" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding Cost}" FontSize="16"/>

                                        <TextBlock Text="Описание:" FontWeight="Bold" Foreground="#A98743" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding Description}" FontSize="16" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

           
        </Grid>
    </Grid>
</UserControl>
