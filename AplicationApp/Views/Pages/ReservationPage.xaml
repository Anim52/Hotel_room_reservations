<UserControl x:Class="AplicationApp.Views.Pages.ReservationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicationApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FAFAFA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="6.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <StackPanel Grid.Column="0" Margin="20" VerticalAlignment="Center">
            <Button Content="Подтвердить" 
                  Command="{Binding ConfirmReservationCommand}"  
                  Width="180" Height="50"  
                  Margin="0,10,0,20"
                  Background="#4CAF50" Foreground="White"
                  FontWeight="Bold" BorderThickness="0"
                  Cursor="Hand"/>
            <Button Content="Заселить" 
                  Command="{Binding SetPopulatedCommand}"  
                  Width="180" Height="50"   
                  Margin="0,10,0,20"
                  Background="#2196F3" Foreground="White"
                  FontWeight="Bold" BorderThickness="0"
                  Cursor="Hand"/>
            <Button Content="Отменить" 
                  Command="{Binding CancelReservationCommand}"  
                  Width="180" Height="50"  
                  Margin="0,10,0,20"
                  Background="#F44336" Foreground="White"
                  FontWeight="Bold" BorderThickness="0"
                  Cursor="Hand"/>
        </StackPanel>

        <!-- Правая панель -->
        <StackPanel Grid.Column="1" Margin="20">
            <TextBlock Text="Управление бронированиями" 
                     FontSize="26" FontWeight="Bold" 
                     Foreground="#333" Margin="0,0,0,20" />

            <ListView ItemsSource="{Binding ReservationList}" 
        SelectedItem="{Binding SelectedReservation}" 
        Margin="0" 
        Background="Transparent"
        BorderThickness="0"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        >
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,15"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                  CornerRadius="12"
                  Padding="15"
                  HorizontalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                            </Border.Effect>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <!-- Фиксированная ширина для иконки номера -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Остальное пространство для данных -->
                                </Grid.ColumnDefinitions>

                                <!-- Иконка номера с фиксированным размером -->
                                <Ellipse Fill="#e0e0e0" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Номер комнаты поверх круга -->
                                <TextBlock Text="{Binding Nomer.Number, FallbackValue='?'}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontWeight="Bold"
                             FontSize="16"
                             Foreground="#444"
                             Grid.Column="0"/>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding Guests.FirstName, FallbackValue='Гость'}"
                                 FontWeight="Bold"
                                 FontSize="16"
                                 Foreground="#222" />

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Заезд: "
                                     FontSize="13"
                                     Foreground="#888"/>
                                        <TextBlock Text="{Binding ArrivalDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                     FontSize="13"
                                     Foreground="#444"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Выезд: "
                                     FontSize="13"
                                     Foreground="#888"/>
                                        <TextBlock Text="{Binding DepartureDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                     FontSize="13"
                                     Foreground="#444"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding StatusRegister, FallbackValue='Статус неизвестен'}"
                                 FontStyle="Italic"
                                 FontSize="13"
                                 Foreground="#666"
                                 Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>


        </StackPanel>
    </Grid>
</UserControl>
