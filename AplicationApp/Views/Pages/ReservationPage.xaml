<UserControl x:Class="AplicationApp.Views.Pages.ReservationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicationApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Управление бронированиями" FontSize="24" Margin="0,0,0,20" />

                <ListBox ItemsSource="{Binding ReservationsList}" 
SelectedItem="{Binding SelectedReservation}" 
Margin="10" 
Background="#f9f9f9"
BorderBrush="#ccc" 
BorderThickness="1"
Padding="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ddd" BorderThickness="0,0,0,1" Padding="10" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding Nomer.Number}" 
                      Width="80" 
                      VerticalAlignment="Center" 
                      FontWeight="Bold" 
                      FontSize="14"
                      Foreground="#333"/>

                                    <TextBlock Text="{Binding Guests.FirstName}" 
                      Width="120" 
                      VerticalAlignment="Center" 
                      FontSize="14"
                      Foreground="#333"
                      Margin="10,0"/>


                                    <TextBlock Text="{Binding ArrivalDate}" 
                      Width="100" 
                      VerticalAlignment="Center" 
                      FontSize="14"
                      Foreground="#333"
                      Margin="10,0"/>


                                    <TextBlock Text="{Binding DepartureDate}" 
                      Width="100" 
                      VerticalAlignment="Center" 
                      FontSize="14"
                      Foreground="#333"
                      Margin="10,0"/>


                                    <TextBlock Text="{Binding StatusRegister}" 
                      Width="120" 
                      VerticalAlignment="Center" 
                      FontSize="14"
                      Margin="10,0"/>


                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        <StackPanel Grid.Column="0" Margin="20" VerticalAlignment="Center">

          
                <Button Content="Подтвердить" Command="{Binding ConfirmReservationCommand}" Width="150"  Margin="0,10,0,20"/>
            <Button Content="Заселить" Command="{Binding SetPopulatedCommand}" Width="150"    Margin="0,10,0,20"/>
                <Button Content="Отменить" Command="{Binding CancelReservationCommand}" Width="150"  Margin="0,10,0,20"/>
            
        </StackPanel>
    </Grid>
</UserControl>
