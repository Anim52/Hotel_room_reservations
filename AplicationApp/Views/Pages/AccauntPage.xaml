<UserControl x:Class="AplicationApp.Views.Pages.AccauntPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicationApp.Views.Pages"
             mc:Ignorable="d" 
                      d:DesignHeight="450" d:DesignWidth="1200" Background="#E0E0E0"
         >
    <Grid Margin="30">
        <Border CornerRadius="20" Background="White" Padding="30" 
            >
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,30">
                    <TextBlock Text="Профиль пользователя" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Поля ввода -->
                    <TextBlock Text="ФИО" FontSize="18" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FullName}" Width="600" Height="50" FontSize="16" Margin="0,0,0,15" 
                         Padding="10" BorderThickness="1" BorderBrush="#CCC" Background="#FAFAFA"/>

                    <TextBlock Text="Дата рождения" FontSize="18" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding DateOfBirth, StringFormat=d}" Width="600" Height="50" FontSize="16" Margin="0,0,0,15"
                         Padding="10" BorderThickness="1" BorderBrush="#CCC" Background="#FAFAFA"/>

                    <TextBlock Text="Паспортные данные" FontSize="18" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PassportNumber}" Width="600" Height="50" FontSize="16" Margin="0,0,0,15"
                         Padding="10" BorderThickness="1" BorderBrush="#CCC" Background="#FAFAFA"/>

                    <TextBlock Text="Контактные данные" FontSize="18" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ContactDetails}" Width="600" Height="50" FontSize="16" Margin="0,0,0,15"
                         Padding="10" BorderThickness="1" BorderBrush="#CCC" Background="#FAFAFA"/>

                    <TextBlock Text="Предпочтения" FontSize="18" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Preferences}" Width="600" Height="50" FontSize="16" Margin="0,0,0,15"
                         Padding="10" BorderThickness="1" BorderBrush="#CCC" Background="#FAFAFA"/>
                </StackPanel>

                <!-- Правая часть -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image Source="/Assets/Recources/User.png" Height="220" Margin="0,0,0,30"/>
                    <Button Content="Сохранить"
                        Width="220" Height="55"
                        Background="#1E293B" Foreground="White" FontWeight="Bold" FontSize="16"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
