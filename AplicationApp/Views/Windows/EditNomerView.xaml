<Window x:Class="AplicationApp.Views.Windows.EditNomerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AplicationApp.Views.Windows"
        mc:Ignorable="d"
            Title="EditNomerView" Height="690" Width="800" Background="Transparent"
    WindowStyle="None" ResizeMode="NoResize">
    <Border Background="#F5F5F5" CornerRadius="16" Padding="10" BorderBrush="#CCCCCC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,5,0,10">
                <TextBlock Text="Редактирование номера" 
                       FontSize="22" FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       Foreground="#37474F"
                       Margin="10,0,0,0"/>
                <Button Content="✕" 
                    Click="Close_btn_Click"
                    Width="40" Height="40"
                    Foreground="White"
                    Background="#D32F2F"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    DockPanel.Dock="Right"
                    BorderThickness="0"
                    Cursor="Hand"
                    />
            </DockPanel>

            <!-- Основная форма -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,0,30,10" VerticalAlignment="Top" >

                    <TextBlock Text="Номер:" FontSize="16" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Padding="6" />

                    <TextBlock Text="Этаж:" FontSize="16" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Padding="6" />

                    <TextBlock Text="Фото:" FontSize="16" Margin="0,10,0,0"/>
                    <Button Content="Изменить фото" 
                        Command="{Binding SelectImageCommand}" 
                        Margin="0,5,0,0" Width="180" Height="40"
                        HorizontalAlignment="Left" />

                    <TextBlock Text="Стоимость:" FontSize="16" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Padding="6" />

                    <TextBlock Text="Описание:" FontSize="16" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="6"/>

                    <TextBlock Text="Тип номера:" FontSize="16" Margin="0,10,0,0"/>
                    <ComboBox ItemsSource="{Binding TypeNumderList}" 
                          SelectedItem="{Binding SelectedTypeNumder}" 
                          Margin="0,5,0,0" Padding="4" Height="30"/>

                    <Button Content="Сохранить"
                        Command="{Binding EditNomerCommand}"
                        HorizontalAlignment="Center"
                        Width="200" Height="50"
                        Margin="0,20,0,10"
                        Background="#1976D2"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        BorderThickness="0"
                        />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
