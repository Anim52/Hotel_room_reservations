<Window x:Class="AplicationApp.UserMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AplicationApp"
        mc:Ignorable="d"
        Title="UserMainWindow" Height="780" Width="1200"
        Background="#E0E0E0"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="12*"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button x:Name="btn1" Width="150" Height="60" Tag="Аккаунт" Click="btn1_Click" Margin="8" Style="{StaticResource MainButton1}">
                    <Image Source="/Assets/Recources/Accaunt.png" />
                </Button>

                <Button x:Name="btn5" Width="150" Height="60" Tag="Услуги" Margin="8" Style="{StaticResource MainButton1}" Click="btn5_Click">
                    <Image Source="/Assets/Recources/Service.png"/>
                </Button>
                
                <Button x:Name="btn6" Width="220" Height="60" Tag="Бронирование" Margin="8" Style="{StaticResource MainButton1}" Click="btn6_Click">
                    <Image Source="/Assets/Recources/Reservation.png"/>
                </Button>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="443,0,0,0">
                    <Button Content="UnLogin" Width="110" Height="60" Name="UnLoginBtn" Click="UnLoginBtn_Click" Margin="5"  FontWeight="Bold"/>
                    <Button x:Name="Close_btn" Content="❌"  Width="60" Height="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Right" Foreground="Black" Margin="0,0,0,0" Click="Close_btn_Click"/>

                </StackPanel>
            </StackPanel>
        </Grid>
        <ContentControl x:Name="ContentControlFrame" Grid.Row="1"/>
    </Grid>
</Window>
